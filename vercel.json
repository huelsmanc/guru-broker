{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/fn/[name].js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    },
    "api/hooks/db.js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    },
    "api/file.js": {
      "maxDuration": 15,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/functions/:name",
      "destination": "/api/fn/:name"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!api/|assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
