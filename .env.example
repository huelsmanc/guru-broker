# Copy to .env.local for local development, and add the same names in Vercel.

# --- Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://fozmqivnjoghsupnqvod.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://fozmqivnjoghsupnqvod.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never expose

# --- App
APP_URL=https://gurubroker.app
HOOK_SECRET=                        # long random string; same value in private.app_config
SIGNING_TOKEN_SECRET=               # long random string; protects signing links

# --- Email (resend.com)
RESEND_API_KEY=
EMAIL_FROM=Guru Broker <noreply@gurubroker.app>

# --- AI: set one or both. AI_PROVIDER picks the first choice; the other is the backup.
AI_PROVIDER=anthropic               # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                    # optional, defaults to claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=                       # optional, defaults to gpt-4.1

# --- Payouts by direct deposit (payload.com). Bank details stay with Payload.
PAYLOAD_SECRET_KEY=
PAYLOAD_PROCESSING_ID=

# --- Phone/desktop push notifications: optional. The app makes its own keys the first time
# it needs them and keeps them in the database. Set these only to use keys you already have
# (`node scripts/gen-vapid.mjs` prints a new pair).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Voice and video calls (daily.co -> Developers -> API keys)
DAILY_API_KEY=

# --- MLS (see SETUP.md)
MLS_SOURCES=
SMARTMLS_TYPE=rets
SMARTMLS_FEED=vow
SMARTMLS_LOGIN_URL=
SMARTMLS_USERNAME=
SMARTMLS_PASSWORD=
SMARTMLS_USER_AGENT=
SMARTMLS_UA_PASSWORD=
SMARTMLS_CLASS=
